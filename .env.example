# Cualquier string largo y random (firma la cookie de sesión)
AUTH_SECRET=
# Cuentas fijas (las de antes de Google): usuario:contraseña separadas por coma. Opcional con Google prendido.
AUTH_USERS=Human:tu-contraseña
# Quiénes son admin: mails de Google o cuentas fijas. Sin esto, la primera de AUTH_USERS.
# ADMINS=vos@gmail.com,Human
# "Seguir con Google" (Supabase Auth). Prenderlo recién cuando el proveedor de Google esté configurado en Supabase.
# AUTH_GOOGLE=1

# IA: key de DeepSeek (platform.deepseek.com)
DEEPSEEK_API_KEY=
# Opcionales
# DEEPSEEK_MODEL=deepseek-flash   (modelo de la generación; el chat se elige en la pantalla)
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Base de datos (Supabase → Project Settings → API Keys). La secret key es solo del server.
SUPABASE_URL=https://fkrfqburxpqtafytnkoy.supabase.co
SUPABASE_SECRET_KEY=
# Para el login con Google (no es secreta)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_F0ihR-UVzgfA_Vq0AOOBMw_HW5hHVTB

# Notas de voz: transcripción con Whisper en Groq (console.groq.com). Tiene plan gratis.
GROQ_API_KEY=
# Opcional: GROQ_STT_MODEL=whisper-large-v3-turbo

# WhatsApp (Cloud API de Meta). Sin token, en desarrollo o con LLM_MOCK=1, se simula (nada sale a Meta).
# WHATSAPP_TOKEN=          (token de acceso; para pruebas sirve el temporal de "Configuración de la API")
# WHATSAPP_APP_SECRET=     (Meta → Configuración de la app → Básica → Clave secreta: verifica los avisos)
# WHATSAPP_VERIFY_TOKEN=   (lo inventás vos y pegás el mismo en Meta al configurar el webhook)
# WA_DEBOUNCE_MS=4000      (cuánto espera por si el cliente manda más mensajes)
# Mail de contacto que muestra la política de privacidad (/privacy), que pide Meta para publicar la app
# CONTACT_EMAIL=

# Desarrollo sin key: respuestas simuladas (y, sin Supabase, "Seguir con Google" crea una cuenta de prueba)
# LLM_MOCK=1
